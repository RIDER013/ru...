<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rider Assistant - Live Test &amp; Tutorial"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp"/>

    <!-- 1. Proximity Sensor Test Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="15dp"
        android:layout_marginBottom="15dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Proximity Sensor (Camera Right Side)"
            android:textColor="#03DAC5"
            android:textStyle="bold"/>

        <TextView
            android:id="@+n/txtProxStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Pending ❌ (Cover camera sensor with hand)"
            android:textColor="#B0BEC5"
            android:layout_marginTop="5dp"/>
    </LinearLayout>

    <!-- 2. Voice Command Test Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
            android:padding="15dp"
        android:layout_marginBottom="15dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Voice Command ('Rider' / 'Varti')"
            android:textColor="#03DAC5"
            android:textStyle="bold"/>

        <TextView
            android:id="@+n/txtVoiceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Pending ❌ (Say 'Rider' clearly)"
            android:textColor="#B0BEC5"
            android:layout_marginTop="5dp"/>
    </LinearLayout>

    <!-- 3. Bluetooth Earbuds Test Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="15dp"
        android:layout_marginBottom="25dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Bluetooth Earbuds Connection"
            android:textColor="#03DAC5"
            android:textStyle="bold"/>

        <TextView
            android:id="@+n/txtBtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Checking Bluetooth Connection..."
            android:textColor="#B0BEC5"
            android:layout_marginTop="5dp"/>
    </LinearLayout>

    <Button
        android:id="@+n/btnFinishTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Finish &amp; Start Assistant"
        android:backgroundTint="#6200EE"
        android:enabled="false"/>

</LinearLayout>