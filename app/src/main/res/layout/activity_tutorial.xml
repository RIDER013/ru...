<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080C14"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Top Bar with Back Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="← back"
            android:textSize="12sp"
            android:textColor="#94A3B8"
            android:backgroundTint="#1E293B"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

        <TextView
            android:id="@+id/txtTestType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="test"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="end"
            android:textAllCaps="true"/>
    </LinearLayout>

    <!-- Center Content:
         click sensor
         conectyvity
         dot (White color -> Sky Blue on connectivity)
         not conectyvity (if not connected) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- conectyvity label -->
        <TextView
            android:id="@+id/txtConnectivityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="conectyvity"
            android:textSize="16sp"
            android:textColor="#E2E8F0"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="16dp"/>

        <!-- Dot: White color circle, turns Sky Blue if connectivity is found -->
        <View
            android:id="@+id/viewConnectivityDot"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/circle_white_dot"
            android:layout_marginBottom="14dp"/>

        <!-- not conectyvity text (shown if not connected) -->
        <TextView
            android:id="@+id/txtNotConnectivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="not conectyvity"
            android:textSize="13sp"
            android:textColor="#EF4444"
            android:textStyle="bold"
            android:visibility="visible"/>
    </LinearLayout>

    <!-- Bottom: created by ƦƗƉƐƦ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="created by ƦƗƉƐƦ"
        android:textSize="10sp"
        android:textColor="#64748B"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:layout_marginBottom="8dp"/>

</LinearLayout>